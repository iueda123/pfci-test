# ルート .env.example — JavaFXアプリ と dispatcher（client側）が読む変数のtemplateです。
# 実際の値はこのファイルに書かず、コピーして .env を作ってください（.env はgit管理外）。
# .env は誰も自動で読みません。processの環境変数として渡します: set -a; source .env; set +a
#
# 変数の直前の "# @" 行は scripts/doctor.sh が読むメタデータです。変数を増減したら一緒に更新してください。
#   @scope    この変数を読むprocess（app / dispatcher）
#   @stage    doctorがこの変数を検査する段階（scripts/setup/stages.sh のstage id）
#   @required 未設定ならそのstageは不合格
#   @optional 未設定でも既定値で動く
#   @secret   doctorは設定の有無だけを表示し、値は決して表示しない
#   @format   値が満たすべき正規表現
#   @example  期待する値の実例（空白を含めない。setup.shとdoctorが「例:」として表示します）
#   @doc      説明のある資料

# @scope=app @stage=env-app @required @format=^https?://[^/]+/?$ @example=https://abcdefghijklmnopqrst.supabase.co @doc=docs/setup-env.md#javafxアプリが読む変数
# Supabase Project URL。/functions/v1 は付けない（コード側で付与されます）
REPORT_API_URL=http://127.0.0.1:54321

# @scope=app @stage=env-app @required @secret @example=sb_publishable_AbCdEf0123456789 @doc=docs/setup-env.md#26-鍵の種類を見分ける
# sb_publishable_... 形式。service-role keyやsecret keyを絶対に置かない
SUPABASE_PUBLISHABLE_KEY=local-publishable-key

# @scope=app @stage=local-bundle @optional @doc=docs/setup-app.md#14-画面の操作とそのとき起きること
# bundleの出力先。rawを含むので共有されないpathにする
REPORT_OUTPUT_DIR=local-reports

# @scope=dispatcher @stage=dispatcher-env @required @format=/functions/v1/dispatcher-control$ @example=https://abcdefghijklmnopqrst.supabase.co/functions/v1/dispatcher-control @doc=docs/setup-env.md#dispatcherが読む変数
DISPATCHER_ENDPOINT=http://127.0.0.1:54321/functions/v1/dispatcher-control

# @scope=dispatcher @stage=dispatcher-env @required @secret @doc=docs/setup-supabase.md#手順5-edge-secretsを設定する
# Edge secretの同名の値と完全一致させる。値は openssl rand -base64 48 で作る
DISPATCHER_TOKEN=replace-with-dedicated-token

# @scope=dispatcher @stage=dispatcher-env @required @format=^/ @doc=docs/setup-env.md#dispatcherが読む変数
# private repositoryのclone先。絶対pathであること（例はホームディレクトリから作ります）
DISPATCHER_REPOSITORY=/absolute/path/to/private/repository

# @scope=dispatcher @stage=dispatcher-env @optional @doc=docs/setup-env.md#dispatcherが読む変数
# 未設定時は実行ユーザーの $HOME/Documents/continuous-improvement
DISPATCHER_SCRATCH=

# @scope=dispatcher @stage=dispatcher-env @optional @doc=docs/setup-env.md#dispatcherが読む変数
CODEX_BIN=codex

# @scope=dispatcher @stage=dispatcher-env @optional @doc=docs/setup-env.md#dispatcherが読む変数
CLAUDE_BIN=claude

# @scope=dispatcher @stage=dispatcher-env @optional @format=^[0-9]+$ @doc=docs/setup-app.md#17-issue作成後aiにdraft-prを作らせる
MAX_DIFF_LINES=2000
