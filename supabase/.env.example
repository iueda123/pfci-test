# supabase/.env.example — Supabase Edge Functions（server側）の変数templateです。
# ここに載る値はclientへ配ってはいけません。cloudでは supabase secrets set --env-file で登録し、
# localでは supabase functions serve --env-file で渡します。
# メタデータ行の読み方はルートの .env.example を参照してください。

# @scope=server @stage=edge-secrets @optional @doc=docs/setup-env.md#23-supabaseenvexample--変数リファレンス
# cloudでは予約変数として自動注入されます。明示設定が必要なのはlocalだけです
SUPABASE_URL=https://PROJECT_REF.supabase.co

# @scope=server @stage=edge-secrets @optional @secret @doc=docs/setup-env.md#23-supabaseenvexample--変数リファレンス
# RLSを迂回する管理者鍵。cloudでは自動注入。絶対にclientへ配らない
SUPABASE_SERVICE_ROLE_KEY=replace-at-deploy-time

# @scope=server @stage=edge-secrets @optional @format=^[0-9]+$ @example=123456 @doc=docs/setup-supabase.md#手順4-github-appを2つ用意する
# Edge用GitHub AppのGeneral画面に表示されるApp ID
GITHUB_APP_ID=123456

# @scope=server @stage=edge-secrets @optional @secret @doc=docs/setup-supabase.md#手順4-github-appを2つ用意する
# Edge用GitHub Appのprivate key PEMをbase64で1行にした値
GITHUB_APP_PRIVATE_KEY_BASE64=replace-at-deploy-time

# @scope=server @stage=edge-secrets @optional @secret @doc=docs/setup-supabase.md#手順5-edge-secretsを設定する
# 移行時のみ使う旧方式。1時間で失効するため、上のApp ID/private keyを優先する
GITHUB_APP_TOKEN=

# @scope=server @stage=edge-secrets @required @format=^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ @example=octocat/Hello-World @doc=docs/setup-supabase.md#手順4-github-appを2つ用意する
# owner/repo の形。cloneのURL（git@github.com:owner/repo.git）ではありません
GITHUB_REPOSITORY=owner/private-repository

# @scope=server @stage=edge-secrets @required @secret @doc=docs/setup-supabase.md#手順5-edge-secretsを設定する
# ルート .env の同名の値と完全一致させる。値は openssl rand -base64 48 で作る
DISPATCHER_TOKEN=replace-with-a-dedicated-random-secret
