[Unit]
Description=Continuous improvement dispatcher
After=network-online.target

[Service]
Type=oneshot
User=improvement-dispatcher
WorkingDirectory=/opt/continuous-improvement
EnvironmentFile=/etc/continuous-improvement/dispatcher.env
ExecStart=/opt/continuous-improvement/scripts/run-dispatcher.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/continuous-improvement /home/improvement-dispatcher/Documents/continuous-improvement

[Install]
WantedBy=multi-user.target
